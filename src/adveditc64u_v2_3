 * - Save/Load using IEC device numbers (USB on Ultimate is typically mapped as device 8/9/etc.)
 * - No modern libc assumptions; uses conio + cbm I/O only
 *
 * Build on Linux (Pop!_OS):
 *   cl65 -t c64 -O -o adveditC64u.prg adveditC64u.c
 *
 * Run on C64 / Ultimate:
 *   LOAD"ADVEDITC64U.PRG",8,1
 *   RUN
 *
 * Keys:
 *   F1  File menu   (Open/Save/Save As/Close/Quit)
 *   F3  Edit menu   (Copy/Cut/Paste/Search/Search+Replace)
 *   F5  Help menu   (About)
 *   CTRL+U          Toggle Force-Uppercase typing (fixes "Shift+letter" frustration)
 *   RETURN          New line
 *   DEL             Backspace
 *   Cursor keys     Move
 *
 * Notes:
 * - Screen is 40x25 on stock C64. We use a 23-line viewport with a top menu bar + status line.
 * - Internal line capacity is 80 columns to preserve longer lines in files, but display is 40 columns.
 * - "Wrap" here is a hard wrap at column 40 while typing (nano-like on a 40-col display).
 */

#include <c64.h>
#include <conio.h>
#include <cbm.h>
#include <string.h>
#include <ctype.h>

/* -----------------------------
   Screen layout (40x25)
------------------------------ */
#define SCREEN_W        40
#define SCREEN_H        25
#define VIEW_Y          1
#define VIEW_H          23
#define STATUS_Y        24

/* Text model */
#define MAX_LINES       250
#define MAX_COLS        80   /* internal line capacity; viewport shows 40 */
#define CLIP_MAX        80
#define WRAP_COL        40   /* hard wrap point while typing (0..39 on screen, so 40 chars per line) */

/* CBM file I/O */
#define LFN_DATA        2
#define DEFAULT_DEVICE  8

/* -----------------------------
   Global editor state
------------------------------ */
static char lines[MAX_LINES][MAX_COLS + 1];
static unsigned int line_count = 1;

static unsigned int cur_line = 0;
static unsigned int cur_col  = 0;
static unsigned int view_top = 0;

static char current_name[32];
static unsigned int current_device = DEFAULT_DEVICE;
static unsigned char has_filename = 0;

static char clipboard[CLIP_MAX + 1];
static unsigned char clipboard_set = 0;

/* Typing behavior */
static unsigned char force_upper = 1; /* fixes "Shift+letter doesn't work" by forcing letters to uppercase */

/* -----------------------------
   Tiny helpers (no sprintf)
------------------------------ */
static unsigned int ustrlen(const char* s) {
    unsigned int n = 0;
    while (*s++) n++;
    return n;
}


/* Append unsigned integer to C string buffer (avoids sprintf). */
static void append_u16(char* buf, unsigned int v) {
    char t[6];
    unsigned int i = 0;

    if (v == 0) {
        t[i++] = '0';
    } else {
        unsigned int p = 10000;
        unsigned char started = 0;
        while (p) {
            unsigned int d = v / p;
            if (d || started) {
                t[i++] = (char)('0' + d);
                started = 1;
            }
            v = (unsigned int)(v % p);
            p = (unsigned int)(p / 10);
        }
    }
    t[i] = 0;
    strcat(buf, t);
}
static void status_clear(void) {
    cclearxy(0, STATUS_Y, SCREEN_W);
}

static void status_msg(const char* msg) {
    status_clear();
    gotoxy(0, STATUS_Y);
    cputs(msg);
}

static void status_fileline(void) {
    char buf[80];
    char namebuf[40];

    if (has_filename) {
        strncpy(namebuf, current_name, sizeof(namebuf)-1);
        namebuf[sizeof(namebuf)-1] = 0;
    } else {
        strcpy(namebuf, "Untitled");
    }

    buf[0] = 0;

    /* DEV xx */
    strcat(buf, "DEV ");
    buf[strlen(buf)+1] = 0;
    buf[strlen(buf)] = (char)('0' + (current_device / 10));
    buf[strlen(buf)+1] = 0;
    buf[strlen(buf)] = (char)('0' + (current_device % 10));
    buf[strlen(buf)+1] = 0;
    buf[strlen(buf)] = ' ';
    buf[strlen(buf)+1] = 0;

    /* filename */
    strcat(buf, namebuf);

    /* mode */
    strcat(buf, force_upper ? "  UPPER" : "  mixed");

    /* Ln/Col */
    strcat(buf, "  Ln ");
    {
        unsigned int ln = cur_line + 1;
        unsigned int cc = cur_col + 1;
        char t[2];

        /* Ln */
        if (ln >= 100) { t[0] = (char)('0' + (ln/100)); t[1]=0; strcat(buf, t); ln%=100; }
        if (ln >= 10)  { t[0] = (char)('0' + (ln/10));  t[1]=0; strcat(buf, t); ln%=10; }
        t[0] = (char)('0' + ln); t[1]=0; strcat(buf, t);

        strcat(buf, " Col ");

        /* Col */
        if (cc >= 100) { t[0] = (char)('0' + (cc/100)); t[1]=0; strcat(buf, t); cc%=100; }
        if (cc >= 10)  { t[0] = (char)('0' + (cc/10));  t[1]=0; strcat(buf, t); cc%=10; }
        t[0] = (char)('0' + cc); t[1]=0; strcat(buf, t);
    }

    buf[SCREEN_W] = 0;
    status_msg(buf);
}

static void clamp_col(void) {
    unsigned int len = ustrlen(lines[cur_line]);
    if (cur_col > len) cur_col = len;
}

static void ensure_visible(void) {
    if (cur_line < view_top) view_top = cur_line;
    if (cur_line >= view_top + VIEW_H) view_top = (cur_line - VIEW_H + 1);
}

/* -----------------------------
   UI: menu bar + viewport
------------------------------ */
static void draw_menu_bar(void) {
    revers(1);
    gotoxy(0,0);
    cclear(SCREEN_W);
    gotoxy(0,0);
    cputs(" File  Edit  Help   (F1) (F3) (F5)   ");
    revers(0);
}

static void draw_view(void) {
    unsigned int r;
    for (r = 0; r < VIEW_H; r++) {
        unsigned int idx = view_top + r;
        gotoxy(0, (unsigned char)(VIEW_Y + r));
        cclear(SCREEN_W);
        gotoxy(0, (unsigned char)(VIEW_Y + r));
        if (idx < line_count) {
            char temp[41];
            unsigned int i;
            for (i = 0; i < SCREEN_W; i++) {
                char ch = lines[idx][i];
                if (!ch) break;
                temp[i] = ch;
            }
            temp[i] = 0;
            cputs(temp);
        }
    }
}

static void place_caret(void) {
    unsigned int screen_y;
    unsigned int screen_x;

    ensure_visible();

    screen_y = VIEW_Y + (cur_line - view_top);
    screen_x = cur_col;
    if (screen_x > 39) screen_x = 39;

    gotoxy((unsigned char)screen_x, (unsigned char)screen_y);
}

/* -----------------------------
   Prompt input (no cgets)
------------------------------ */
static void prompt_input(const char* prompt, char* out, unsigned int outmax) {
    unsigned int n = 0;
    unsigned char ch;
    unsigned int px = ustrlen(prompt);

    out[0] = 0;

    status_clear();
    gotoxy(0, STATUS_Y);
    cputs(prompt);

    while (1) {
        ch = cgetc();

        if (ch == 13) { /* RETURN */
            out[n] = 0;
            break;
        } else if (ch == 20) { /* DEL/backspace */
            if (n > 0) {
                n--;
                out[n] = 0;
                gotoxy((unsigned char)(px + n), STATUS_Y);
                cputc(' ');
                gotoxy((unsigned char)(px + n), STATUS_Y);
            }
        } else if (ch >= 32 && ch <= 126) {
            if (n < outmax - 1) {
                out[n++] = (char)ch;
                out[n] = 0;
                cputc((char)ch);
            }
        }
    }
}

static unsigned int parse_device_or_default(const char* s, unsigned int defdev) {
    unsigned int d = 0;
    unsigned char any = 0;
    while (*s) {
        if (isdigit((unsigned char)*s)) {
            any = 1;
            d = (unsigned int)(d * 10 + (unsigned int)(*s - '0'));
        } else {
            break;
        }
        s++;
    }
    if (!any) return defdev;
    if (d == 0) return defdev;
    return d;
}

/* -----------------------------
   Editing primitives
------------------------------ */
static void split_line(void);

static void wrap_if_needed(void) {
    if (cur_col >= WRAP_COL) {
        if (cur_col > WRAP_COL) cur_col = WRAP_COL;
        split_line();
    }
}

static void insert_char(char ch) {
    unsigned int len = ustrlen(lines[cur_line]);
    unsigned int i;

    if (len >= MAX_COLS) return;

    for (i = len + 1; i > cur_col; i--) {
        lines[cur_line][i] = lines[cur_line][i-1];
    }
    lines[cur_line][cur_col] = ch;
    cur_col++;

    wrap_if_needed();
}

static void backspace_char(void) {
    unsigned int len = ustrlen(lines[cur_line]);
    unsigned int i;

    if (cur_col > 0) {
        for (i = cur_col - 1; i < len; i++) {
            lines[cur_line][i] = lines[cur_line][i+1];
        }
        if (cur_col) cur_col--;
    } else {
        if (cur_line > 0) {
            unsigned int prev = cur_line - 1;
            unsigned int prevlen = ustrlen(lines[prev]);
            unsigned int curlen  = ustrlen(lines[cur_line]);

            if (prevlen + curlen <= MAX_COLS) {
                strcat(lines[prev], lines[cur_line]);
                for (i = cur_line; i + 1 < line_count; i++) {
                    strcpy(lines[i], lines[i+1]);
                }
                if (line_count > 0) line_count--;
                cur_line = prev;
                cur_col = prevlen;
            }
        }
    }
}

static void split_line(void) {
    unsigned int i;
    unsigned int newLine;

    if (line_count >= MAX_LINES) return;

    for (i = line_count; i > cur_line + 1; i--) {
        strcpy(lines[i], lines[i-1]);
    }
    line_count++;
    newLine = cur_line + 1;

    strcpy(lines[newLine], lines[cur_line] + cur_col);
    lines[cur_line][cur_col] = 0;

    cur_line = newLine;
    cur_col  = 0;
}

/* Clipboard ops (line-based) */
static void copy_line(void) {
    strncpy(clipboard, lines[cur_line], CLIP_MAX);
    clipboard[CLIP_MAX] = 0;
    clipboard_set = 1;
    status_msg("Copied line.");
}

static void cut_line(void) {
    unsigned int i;
    copy_line();
    for (i = cur_line; i + 1 < line_count; i++) {
        strcpy(lines[i], lines[i+1]);
    }
    if (line_count > 1) line_count--;
    if (cur_line >= line_count) cur_line = line_count - 1;
    cur_col = 0;
    status_msg("Cut line.");
}

static void paste_line(void) {
    unsigned int i;

    if (!clipboard_set) {
        status_msg("Clipboard empty.");
        return;
    }
    if (line_count >= MAX_LINES) return;

    for (i = line_count; i > cur_line + 1; i--) {
        strcpy(lines[i], lines[i-1]);
    }
    line_count++;
    strcpy(lines[cur_line + 1], clipboard);

    cur_line++;
    cur_col = 0;
    status_msg("Pasted line.");
}

/* Search */
static unsigned char search_next(const char* needle) {
    unsigned int ln;
    unsigned int nlen = ustrlen(needle);

    if (nlen == 0) return 0;

    for (ln = cur_line; ln < line_count; ln++) {
        unsigned int len = ustrlen(lines[ln]);
        unsigned int col;
        unsigned int startcol = (ln == cur_line) ? cur_col : 0;

        if (len < nlen) continue;

        for (col = startcol; col + nlen <= len; col++) {
            if (memcmp(lines[ln] + col, needle, nlen) == 0) {
                cur_line = ln;
                cur_col  = col;
                return 1;
            }
        }
    }
    return 0;
}

static unsigned char replace_here(const char* needle, const char* repl) {
    unsigned int nlen = ustrlen(needle);
    unsigned int rlen = ustrlen(repl);
    unsigned int len  = ustrlen(lines[cur_line]);
    unsigned int i;

    if (nlen == 0) return 0;
    if (cur_col + nlen > len) return 0;
    if (memcmp(lines[cur_line] + cur_col, needle, nlen) != 0) return 0;
    if (len - nlen + rlen > MAX_COLS) return 0;

    if (rlen > nlen) {
        unsigned int shift = rlen - nlen;
        for (i = len + shift; i >= cur_col + rlen; i--) {
            lines[cur_line][i] = lines[cur_line][i - shift];
            if (i == 0) break;
        }
    } else if (rlen < nlen) {
        unsigned int shift2 = nlen - rlen;
        for (i = cur_col + rlen; i <= len - shift2; i++) {
            lines[cur_line][i] = lines[cur_line][i + shift2];
        }
        lines[cur_line][len - shift2] = 0;
    }

    memcpy(lines[cur_line] + cur_col, repl, rlen);
    return 1;
}

/* -----------------------------
   CBM file I/O (Ultimate friendly)
------------------------------ */
static unsigned char file_load(unsigned int dev, const char* name) {
    static char fname[64];
    unsigned char b;
    unsigned int ln = 0;
    unsigned int col = 0;
    unsigned int i;

    fname[0] = 0;
    strncat(fname, name, 31);
    strcat(fname, ",S,R");

    for (i = 0; i < MAX_LINES; i++) lines[i][0] = 0;
    line_count = 1;
    cur_line = cur_col = 0;
    view_top = 0;

    if (cbm_open(LFN_DATA, (unsigned char)dev, 2, fname) != 0) {
        status_msg("OPEN failed (load). Check device/name.");
        cbm_close(LFN_DATA);
        return 0;
    }

    while (1) {
        if (cbm_read(LFN_DATA, &b, 1) != 1) break;

        if (b == 13) {
            if (ln + 1 < MAX_LINES) {
                lines[ln][col] = 0;
                ln++;
                col = 0;
                if (ln >= line_count) line_count = ln + 1;
            }
        } else if (b == 10) {
            /* ignore LF */
        } else if (b >= 32 && b <= 126) {
            if (col < MAX_COLS) {
                lines[ln][col++] = (char)b;
                lines[ln][col] = 0;
            }
        }
    }

    cbm_close(LFN_DATA);

    line_count = ln + 1;
    if (line_count == 0) line_count = 1;

    strncpy(current_name, name, sizeof(current_name)-1);
    current_name[sizeof(current_name)-1] = 0;
    current_device = dev;
    has_filename = 1;

    status_msg("Loaded.");
    return 1;
}

static unsigned char file_save(unsigned int dev, const char* name) {
    static char fname[64];
    unsigned int ln;

    fname[0] = 0;
    strcat(fname, "@0:");
    strncat(fname, name, 31);
    strcat(fname, ",S,W");

    if (cbm_open(LFN_DATA, (unsigned char)dev, 2, fname) != 0) {
        status_msg("OPEN failed (save). Check device/name.");
        cbm_close(LFN_DATA);
        return 0;
    }

    for (ln = 0; ln < line_count; ln++) {
        unsigned int len = ustrlen(lines[ln]);
        if (len) {
            cbm_write(LFN_DATA, (unsigned char*)lines[ln], (unsigned int)len);
        }
        {
            unsigned char cr = 13;
            cbm_write(LFN_DATA, &cr, 1);
        }
    }

    cbm_close(LFN_DATA);

    strncpy(current_name, name, sizeof(current_name)-1);
    current_name[sizeof(current_name)-1] = 0;
    current_device = dev;
    has_filename = 1;

    status_msg("Saved.");
    return 1;
}

/* -----------------------------
   Dialogs
------------------------------ */
static void dialog_open(void) {
    static char name[32];
    static char devs[8];
    unsigned int d;

    prompt_input("Open name: ", name, sizeof(name));
    if (name[0] == 0) { status_msg("Open cancelled."); return; }

    prompt_input("Device (8/9.. blank=8): ", devs, sizeof(devs));
    d = parse_device_or_default(devs, DEFAULT_DEVICE);

    file_load(d, name);
}

static void dialog_save_as(void) {
    static char name[32];
    static char devs[8];
    unsigned int d;

    prompt_input("Save as name: ", name, sizeof(name));
    if (name[0] == 0) { status_msg("Save As cancelled."); return; }

    prompt_input("Device (8/9.. blank=8): ", devs, sizeof(devs));
    d = parse_device_or_default(devs, DEFAULT_DEVICE);

    file_save(d, name);
}

static void dialog_save(void) {
    if (!has_filename) dialog_save_as();
    else file_save(current_device, current_name);
}

static void dialog_close(void) {
    unsigned int i;
    for (i = 0; i < MAX_LINES; i++) lines[i][0] = 0;
    line_count = 1;
    cur_line = cur_col = 0;
    view_top = 0;
    has_filename = 0;
    current_name[0] = 0;
    current_device = DEFAULT_DEVICE;
    status_msg("Closed (new buffer).");
}

/* -----------------------------
   Menus (boxed, easier than one-line)
------------------------------ */
static void box_clear(unsigned char x, unsigned char y, unsigned char w, unsigned char h, unsigned char inv) {
    unsigned char r;
    revers(inv);
    for (r = 0; r < h; r++) {
        cclearxy(x, (unsigned char)(y + r), w);
    }
    revers(0);
}

static void box_put(unsigned char x, unsigned char y, const char* s) {
    gotoxy(x, y);
    cputs(s);
}

static unsigned char menu_box(const char* title, const char* l1, const char* l2, const char* l3, const char* l4, const char* l5) {
    unsigned char x = 2, y = 3;
    unsigned char w = 36, h = 10;
    unsigned char k;

    box_clear(x, y, w, h, 1);
    revers(0);

    gotoxy(x+2, y+1); cputs(title);
    gotoxy(x+2, y+3); cputs(l1);
    gotoxy(x+2, y+4); cputs(l2);
    gotoxy(x+2, y+5); cputs(l3);
    gotoxy(x+2, y+6); cputs(l4);
    gotoxy(x+2, y+7); cputs(l5);
    gotoxy(x+2, y+8); cputs("ESC cancels");

    k = cgetc();
    box_clear(x, y, w, h, 0);
    return (unsigned char)toupper(k);
}

static unsigned char menu_file(void) {
    unsigned char k = menu_box("FILE",
                               "O  Open",
                               "S  Save",
                               "A  Save As",
                               "C  Close",
                               "Q  Quit");
    if (k == 27) { status_msg(""); return 0; }
    if (k == 'O') { dialog_open(); return 0; }
    if (k == 'S') { dialog_save(); return 0; }
    if (k == 'A') { dialog_save_as(); return 0; }
    if (k == 'C') { dialog_close(); return 0; }
    if (k == 'Q') { return 1; }
    return 0;
}

static void dialog_search(void) {
    static char needle[32];
    prompt_input("Search: ", needle, sizeof(needle));
    if (needle[0] == 0) { status_msg("Search cancelled."); return; }
    if (search_next(needle)) status_msg("Found.");
    else status_msg("Not found.");
}

static void dialog_search_replace(void) {
    static char needle[32];
    static char repl[32];
    unsigned char ok;

    prompt_input("Find: ", needle, sizeof(needle));
    if (needle[0] == 0) { status_msg("Cancelled."); return; }

    prompt_input("Replace with: ", repl, sizeof(repl));

    ok = search_next(needle);
    if (!ok) { status_msg("Not found."); return; }

    if (replace_here(needle, repl)) status_msg("Replaced.");
    else status_msg("Replace failed.");
}

static void menu_edit(void) {
    unsigned char k = menu_box("EDIT",
                               "Y  Copy line",
                               "X  Cut line",
                               "P  Paste line",
                               "F  Search",
                               "R  Search+Replace");
    if (k == 27) { status_msg(""); return; }
    if (k == 'Y') { copy_line(); return; }
    if (k == 'X') { cut_line(); return; }
    if (k == 'P') { paste_line(); return; }
    if (k == 'F') { dialog_search(); return; }
    if (k == 'R') { dialog_search_replace(); return; }
}

static void dialog_about(void) {
    unsigned char k;
    unsigned char x = 2, y = 6;

    box_clear(x, y, 36, 9, 1);
    revers(0);

    box_put(x+2, y+1, "Advanced Commodore Editor");
    box_put(x+2, y+2, "Version 2.2");
    box_put(x+2, y+3, "by Dr. Eric O. Flores (c) 2025");
    box_put(x+2, y+4, "Abacus Super C / cc65");
    box_put(x+2, y+6, "F1 File  F3 Edit  F5 Help");
    box_put(x+2, y+7, "CTRL+U toggles UPPER/mixed");
    box_put(x+2, y+8, "Press any key...");

    k = cgetc();
    (void)k;
    box_clear(x, y, 36, 9, 0);
}

static void menu_help(void) {
    unsigned char k = menu_box("HELP",
                               "A  About",
                               "",
                               "",
                               "",
                               "");
    if (k == 27) { status_msg(""); return; }
    if (k == 'A') { dialog_about(); return; }
}

/* Function keys (cc65 on C64) */
#define KEY_F1  133
#define KEY_F3  134
#define KEY_F5  135

/* CTRL+U (21) */
#define KEY_CTRL_U 21

static void handle_key(unsigned char k, unsigned char* quit_flag) {
    unsigned int len;

    if (k == KEY_F1) { if (menu_file()) *quit_flag = 1; return; }
    if (k == KEY_F3) { menu_edit(); return; }
    if (k == KEY_F5) { menu_help(); return; }

    if (k == KEY_CTRL_U) {
        force_upper = (unsigned char)!force_upper;
        status_msg(force_upper ? "Typing mode: UPPER" : "Typing mode: mixed");
        return;
    }

    if (k == 13) { split_line(); return; }
    if (k == 20) { backspace_char(); return; }

    if (k == 145) { if (cur_line > 0) cur_line--; clamp_col(); return; }     /* Up */
    if (k == 17)  { if (cur_line + 1 < line_count) cur_line++; clamp_col(); return; } /* Down */
    if (k == 157) { /* Left */
        if (cur_col > 0) cur_col--;
        else if (cur_line > 0) { cur_line--; cur_col = ustrlen(lines[cur_line]); }
        return;
    }
    if (k == 29) { /* Right */
        len = ustrlen(lines[cur_line]);
        if (cur_col < len) cur_col++;
        else if (cur_line + 1 < line_count) { cur_line++; cur_col = 0; }
        return;
    }

    if (k >= 32 && k <= 126) {
        char ch = (char)k;
        if (force_upper && isalpha((unsigned char)ch)) ch = (char)toupper((unsigned char)ch);
        insert_char(ch);
        return;
    }
}

/* -----------------------------
   App entry
------------------------------ */
int main(void) {
    unsigned char quit_flag = 0;
    unsigned char k;

    lines[0][0] = 0;
    current_name[0] = 0;
    has_filename = 0;
    current_device = DEFAULT_DEVICE;

    clrscr();
    bgcolor(COLOR_BLUE);
    textcolor(COLOR_WHITE);
    bordercolor(COLOR_BLUE);

    /* Visible cursor */
    cursor(1);

    draw_menu_bar();
    draw_view();
    status_fileline();
    place_caret();

    while (!quit_flag) {
        draw_menu_bar();
        draw_view();
        status_fileline();
        place_caret();

        k = cgetc();
        handle_key(k, &quit_flag);
    }

    clrscr();
    return 0;
}
